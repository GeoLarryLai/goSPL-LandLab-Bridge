license: AGPL-3.0-or-later
repository-code: "https://github.com/GeoLarryLai/goSPL-LandLab-Bridge"
version: "0.0.4"
keywords:
  - landscape evolution
  - source-to-sink
  - goSPL
  - Landlab
  - geomorphology
  - stratigraphy
  - hillslope
  - landslides
  - python
